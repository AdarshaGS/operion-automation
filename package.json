{
  "name": "operion-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone API + UI automation suite for Operion, with a unified pass/fail report",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui --project=ui-anonymous",
    "test:module": "playwright test --grep",
    "typecheck": "tsc --noEmit",
    "report": "tsx src/reporting/open-report.ts",
    "install:browsers": "playwright install chromium",
    "stack:up": "./scripts/stack-up.sh",
    "stack:down": "./scripts/stack-down.sh",
    "test:fresh": "./scripts/stack-down.sh; ./scripts/stack-up.sh && playwright test",
    "test:sanity": "playwright test --project=sanity --workers=1",
    "test:sanity:business": "playwright test --project=sanity --workers=1 tests/sanity/01-business-setup"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}