# Source this to point the suite at the performance stack (backend :8092, frontend :5185) with its own .auth folder.
export OPERION_API_URL=http://localhost:8092
export OPERION_UI_URL=http://localhost:5185
export OPERION_AUTH_DIR=.auth-perf
# The database is already seeded with an organisation (Operion #354 stops a second one being provisioned in it),
# so reuse that seed. Remove this line only after recreating the databases.
export OPERION_REUSE_SEED=1
